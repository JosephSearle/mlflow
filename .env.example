# --- Postgres (metadata/registry backend) ---
# Local: postgresql://mlflow:mlflow@localhost:5432/mlflow  # pragma: allowlist secret
# Prod (Neon): postgresql://neondb_owner:<password>@<host>/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# --- Artifact store (Backblaze B2, S3-compatible) ---
MLFLOW_ARTIFACT_ROOT=b2://your-bucket@s3.<region>.backblazeb2.com/mlflow-artifacts
AWS_ACCESS_KEY_ID=            # B2 Application Key ID (not the master key)
AWS_SECRET_ACCESS_KEY=        # B2 Application Key
AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2  # MLflow's B2 artifact repo reads this specifically; keep in sync with AWS_REGION

# --- Auth0 OIDC (used by oauth2-proxy in front of the MLflow server) ---
# Set AUTH_DISABLED=true for local dev to skip oauth2-proxy entirely.
AUTH_DISABLED=false
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
# The single, permanent front-door URL for this deployment - pins oauth2-proxy's
# OAuth redirect_uri so it never depends on the request's Host header. Leave
# this UNSET on Vercel: it falls back to Vercel's own VERCEL_PROJECT_PRODUCTION_URL
# system env var, which always tracks the project's real Production Domain
# (auto-updates if you add a custom domain later) - just tick "Enable access to
# System Environment Variables" once under Project Settings > Environment
# Variables. Only set PUBLIC_URL explicitly for local dev, where no Vercel vars
# exist, or to override the Vercel default. See README for details.
# Local: http://localhost:5001
PUBLIC_URL=
# MLflow's OWN, separate DNS-rebinding protection (Werkzeug rejects any
# request whose Host header isn't localhost/private-IP/allow-listed - not
# fixed by PUBLIC_URL above, which only pins the OAuth redirect_uri).
# Comma-separated, wildcards supported (e.g. 'mlflow.company.com,192.168.*').
# Leave UNSET: defaults to PUBLIC_URL's own host, which covers Vercel and
# local dev automatically. Only set this to add further allowed hosts.
MLFLOW_SERVER_ALLOWED_HOSTS=
# false for local (plain HTTP) dev; true (or omit) once deployed behind HTTPS
OAUTH2_PROXY_COOKIE_SECURE=false

# --- Auth0 M2M app (service-to-service auth for ops scripts / CI, not humans) ---
# A separate Auth0 application from the one above: Applications > APIs, create
# an API (its "Identifier" is AUTH0_M2M_AUDIENCE), then Applications > create a
# Machine to Machine Application authorized for that API. See README.
AUTH0_M2M_AUDIENCE=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Ops sync scripts ---
# Point at the deployed server for CI sync/validate, or http://localhost:5000 locally.
MLFLOW_TRACKING_URI=http://localhost:5000
# Required when MLFLOW_TRACKING_URI is not local - mint with:
#   export MLFLOW_TRACKING_TOKEN="$(./ops/scripts/get_tracking_token.sh)"
MLFLOW_TRACKING_TOKEN=
